{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DojiFunded",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#f9fbf0",
      "dark": "#060a06"
    }
  },
  "fonts": {
    "family": "Space Grotesk",
    "heading": {
      "family": "DM Sans"
    }
  },
  "colors": {
    "primary": "#B7FF00",
    "light": "#D4FF66",
    "dark": "#7EAF00"
  },
  "favicon": "/images/doji-logo.png",
  "css": "/custom.css",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "how-it-works",
              "doji-accounts",
              "account-pricing",
              "getting-started/faq"
            ]
          },
          {
            "group": "Onboarding",
            "pages": [
              "onboarding/creating-account",
              "onboarding/purchase-an-account",
              "onboarding/user-lifecycle",
              "onboarding/autonomous-agent-strategy-funding"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/overview",
              "platform/terminal",
              "platform/dashboard",
              "platform/explorer",
              "platform/payouts"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "platform/ai-backtesting-engine",
              "platform/ai-copilot"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/available-markets",
              "resources/execution-venues",
              "resources/fees",
              "resources/rules-risk-parameters",
              "resources/partners",
              "resources/bug-reports"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/terms-of-use",
              "legal/privacy-policy"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/quickstart",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Accounts",
            "pages": [
              "api-reference/accounts/create-account",
              "api-reference/accounts/get-account",
              "api-reference/accounts/account-summary",
              "api-reference/accounts/open-positions",
              "api-reference/accounts/position-history",
              "api-reference/accounts/trade-history",
              "api-reference/accounts/funding-payments",
              "api-reference/accounts/breaches",
              "api-reference/accounts/violations",
              "api-reference/accounts/analytics"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "api-reference/orders/place-order",
              "api-reference/orders/list-open-orders",
              "api-reference/orders/cancel-order",
              "api-reference/orders/close-position"
            ]
          },
          {
            "group": "Market data",
            "pages": [
              "api-reference/market-data-api/price",
              "api-reference/market-data-api/orderbook",
              "api-reference/market-data-api/recent-trades",
              "api-reference/market-data-api/tickers",
              "api-reference/market-data-api/ticker-metadata",
              "api-reference/market-data-api/engine-config",
              "api-reference/market-data-api/symbol-metrics"
            ]
          },
          {
            "group": "Integration",
            "pages": [
              "api-reference/webhooks",
              "api-reference/errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Private alpha",
          "href": "https://dojifunded.com",
          "icon": "rocket"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/Doji_Logo_PNG_lightmode.png",
    "dark": "/logo/doji-funded-logo.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start trading",
      "href": "/onboarding/creating-account"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/DojiFunded",
      "discord": "https://discord.gg/dojifunded"
    }
  }
}