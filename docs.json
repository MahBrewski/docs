{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DojiFunded",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Space Grotesk",
    "heading": {
      "family": "DM Sans"
    }
  },
  "colors": {
    "primary": "#B7FF00",
    "light": "#D4FF66",
    "dark": "#7EAF00"
  },
  "favicon": "/images/doji-logo.png",
  "css": "/custom.css",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "how-it-works",
              "doji-accounts"
            ]
          },
          {
            "group": "Onboarding",
            "pages": [
              "onboarding/creating-account",
              "onboarding/purchase-an-account",
              "onboarding/user-lifecycle",
              "onboarding/autonomous-agent-strategy-funding"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/overview",
              "platform/terminal",
              "platform/dashboard",
              "platform/explorer",
              "platform/payouts"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "platform/ai-backtesting-engine",
              "platform/ai-copilot"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/available-markets",
              "resources/execution-venues",
              "resources/fees",
              "resources/rules-risk-parameters",
              "resources/partners",
              "resources/bug-reports"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/terms-of-use",
              "legal/privacy-policy"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/quickstart"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "api-reference/authentication",
              "api-reference/account-endpoints",
              "api-reference/order-endpoints"
            ]
          },
          {
            "group": "Market data",
            "pages": [
              "api-reference/market-data"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/webhooks",
              "api-reference/errors"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Private alpha",
          "href": "https://dojifunded.com",
          "icon": "rocket"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/doji-funded-logo.png",
    "dark": "/logo/doji-funded-logo.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start trading",
      "href": "/onboarding/creating-account"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/DojiFunded"
    }
  }
}
